# ============================================
# Supabase
# ============================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Firebase Dynamic Links (深度链接)
# ============================================
EXPO_PUBLIC_DYNAMIC_LINKS_DOMAIN=your-app.page.link

# ============================================
# Stripe (国际版支付)
# ============================================
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Supabase Edge Function 环境变量 (在 Supabase Dashboard 配置)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# 微信支付 (国内版支付)
# ============================================
# Supabase Edge Function 环境变量 (在 Supabase Dashboard 配置)
# WECHAT_APP_ID=wx_xxx
# WECHAT_MCH_ID=xxx
# WECHAT_API_KEY=xxx
# WECHAT_NOTIFY_URL=https://your-project.supabase.co/functions/v1/wechat-webhook

