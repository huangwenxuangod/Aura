## 快速参考

### 常用命令

```bash
# 安装依赖
pnpm install

# 开发
pnpm expo start

# 类型检查
pnpm tsc --noEmit

# Lint
pnpm eslint .

# Supabase 类型生成
pnpm supabase gen types typescript --project-id $PROJECT_ID > types/database.types.ts

# Supabase 本地开发
pnpm supabase start
pnpm supabase db push
```

### 关键常量

```typescript
// lib/constants.ts

export const CREDIT = {
  MIN_STAKE: 10,
  MAX_STAKE: 1000,
};

export const TIMEOUT = {
  REFEREE_JOIN: 24 * 60 * 60 * 1000,  // 24h
  REFEREE_VOTE: 24 * 60 * 60 * 1000,  // 24h
  POLLING_INTERVAL: 30 * 1000,         // 30s
};

export const RECOVERY = {
  REQUIRED_SUCCESS: 2,
};

export const EXCHANGE_RATE = {
  global: 10,  // $1 = 10 Credit
  cn: 1,       // ¥1 = 1 Credit
};
```

### 状态定义

```typescript
// types/index.ts

export type PredictionStatus = 'ACTIVE' | 'JUDGING' | 'SUCCESS' | 'FAILED';
export type UserStatus = 'IDLE' | 'RECOVERY';
export type RecoveryStatus = 'IN_PROGRESS' | 'RECOVERED' | 'FORFEITED';
export type Vote = 'YES' | 'NO';
export type Region = 'global' | 'cn';
```
